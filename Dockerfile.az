FROM debian:13
RUN apt update && apt upgrade -y && apt install -y  wget
WORKDIR /tmp
RUN wget https://go.dev/dl/go1.27.2.linux-amd64.tar.gz && \
    tar -C /usr/local -xzf go1.27.2.linux-amd64.tar.gz && \
    rm go1.27.2.linux-amd64.tar.gz
ENV PATH="/usr/local/go/bin:${PATH}"


RUN apt update && apt upgrade -y && apt install -y nodejs git bash-completion zsh fish git-filter-repo